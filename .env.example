# ===========================================
# CONFIGURACIÓN DE ENTORNO - NineSys API
# ===========================================
# Copia este archivo a .env y configura los valores

# API Key de Google Gemini (obtener en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Configuración del motor de base de datos
DB_DRIVER=mysql  # mysql (MariaDB) o pgsql (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=3306     # 3306 para mysql / 5432 para pgsql
DB_NAME=api_empresas
DB_USER=dev_user
DB_PASS=dev_pass

# Integración con 19print_app (login de clientes por teléfono, fallback
# manual de clave desde app_multi "Gestión de Clientes"). TOKEN_19PRINT_ADMIN
# debe ser EXACTAMENTE el mismo valor que INTEGRACION_ADMIN_TOKEN del backend
# de 19print_app (packages/backend/.env) -- son las dos mitades del mismo
# secreto compartido servidor-a-servidor.
URL_19PRINT_API=https://dtf.nineteencustom.com/api
TOKEN_19PRINT_ADMIN=

# Sesión de usuario real (JWT, auditoría de seguridad 2026-09-10 -- reemplaza
# gradualmente el header Authorization: <id_empresa> crudo). JWT_SECRET se
# genera con: openssl rand -base64 48. Sin refresh token (decisión de
# producto): al expirar, el usuario vuelve a loguearse.
JWT_SECRET=
JWT_TTL_HOURS=24

# Autenticación servidor-a-servidor (header X-Internal-Token, hash_equals())
# para llamadas que traen id_empresa como parámetro en vez de sesión de un
# usuario humano -- un secreto por servicio, cada uno debe coincidir
# EXACTAMENTE con su contraparte en el otro repo.
# msg_ninesys -> ninesys-api (ya existía, sin documentar aquí hasta ahora):
MSG_SERVICE_INTERNAL_TOKEN=
# 19print_app (backend) -> ninesys-api (nuevo): debe ser idéntico a
# NINESYS_API_INTERNAL_TOKEN en 19print_app/packages/backend/.env.
PRINT_SERVICE_INTERNAL_TOKEN=
